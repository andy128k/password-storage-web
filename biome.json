{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!coverage",
      "!dist",
      "!public",
      "!**/src/routeTree.gen.ts"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noUselessElse": "off",
        "useTemplate": "off"
      },
      "a11y": {
        "useHtmlLang": "warn",
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn"
      }
    }
  },
  "javascript": {
    "jsxRuntime": "reactClassic"
  }
}
